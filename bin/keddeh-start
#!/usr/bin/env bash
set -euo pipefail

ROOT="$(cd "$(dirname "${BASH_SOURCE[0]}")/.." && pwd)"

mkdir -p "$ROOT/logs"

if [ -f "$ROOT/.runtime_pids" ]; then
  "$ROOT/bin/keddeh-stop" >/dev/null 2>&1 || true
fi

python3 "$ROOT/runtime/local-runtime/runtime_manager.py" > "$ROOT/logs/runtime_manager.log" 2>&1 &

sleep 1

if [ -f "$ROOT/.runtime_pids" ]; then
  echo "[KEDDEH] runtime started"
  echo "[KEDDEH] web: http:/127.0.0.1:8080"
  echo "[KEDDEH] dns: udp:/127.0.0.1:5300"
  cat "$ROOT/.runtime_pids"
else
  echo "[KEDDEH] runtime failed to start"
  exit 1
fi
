#!/usr/bin/env python3
"""Simple HTTP server for KEDDEH.COM website."""
from __future__ import annotations

import os
import sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WEBSITE_DIR = ROOT / "apps" / "www"


class KeddehHandler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(WEBSITE_DIR), **kwargs)


def main() -> None:
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
    server = ThreadingHTTPServer(("0.0.0.0", port), KeddehHandler)
    print(f"[KEDDEH-WEB] listening on http://127.0.0.1:{port}")
    server.serve_forever()


if __name__ == "__main__":
    main()
