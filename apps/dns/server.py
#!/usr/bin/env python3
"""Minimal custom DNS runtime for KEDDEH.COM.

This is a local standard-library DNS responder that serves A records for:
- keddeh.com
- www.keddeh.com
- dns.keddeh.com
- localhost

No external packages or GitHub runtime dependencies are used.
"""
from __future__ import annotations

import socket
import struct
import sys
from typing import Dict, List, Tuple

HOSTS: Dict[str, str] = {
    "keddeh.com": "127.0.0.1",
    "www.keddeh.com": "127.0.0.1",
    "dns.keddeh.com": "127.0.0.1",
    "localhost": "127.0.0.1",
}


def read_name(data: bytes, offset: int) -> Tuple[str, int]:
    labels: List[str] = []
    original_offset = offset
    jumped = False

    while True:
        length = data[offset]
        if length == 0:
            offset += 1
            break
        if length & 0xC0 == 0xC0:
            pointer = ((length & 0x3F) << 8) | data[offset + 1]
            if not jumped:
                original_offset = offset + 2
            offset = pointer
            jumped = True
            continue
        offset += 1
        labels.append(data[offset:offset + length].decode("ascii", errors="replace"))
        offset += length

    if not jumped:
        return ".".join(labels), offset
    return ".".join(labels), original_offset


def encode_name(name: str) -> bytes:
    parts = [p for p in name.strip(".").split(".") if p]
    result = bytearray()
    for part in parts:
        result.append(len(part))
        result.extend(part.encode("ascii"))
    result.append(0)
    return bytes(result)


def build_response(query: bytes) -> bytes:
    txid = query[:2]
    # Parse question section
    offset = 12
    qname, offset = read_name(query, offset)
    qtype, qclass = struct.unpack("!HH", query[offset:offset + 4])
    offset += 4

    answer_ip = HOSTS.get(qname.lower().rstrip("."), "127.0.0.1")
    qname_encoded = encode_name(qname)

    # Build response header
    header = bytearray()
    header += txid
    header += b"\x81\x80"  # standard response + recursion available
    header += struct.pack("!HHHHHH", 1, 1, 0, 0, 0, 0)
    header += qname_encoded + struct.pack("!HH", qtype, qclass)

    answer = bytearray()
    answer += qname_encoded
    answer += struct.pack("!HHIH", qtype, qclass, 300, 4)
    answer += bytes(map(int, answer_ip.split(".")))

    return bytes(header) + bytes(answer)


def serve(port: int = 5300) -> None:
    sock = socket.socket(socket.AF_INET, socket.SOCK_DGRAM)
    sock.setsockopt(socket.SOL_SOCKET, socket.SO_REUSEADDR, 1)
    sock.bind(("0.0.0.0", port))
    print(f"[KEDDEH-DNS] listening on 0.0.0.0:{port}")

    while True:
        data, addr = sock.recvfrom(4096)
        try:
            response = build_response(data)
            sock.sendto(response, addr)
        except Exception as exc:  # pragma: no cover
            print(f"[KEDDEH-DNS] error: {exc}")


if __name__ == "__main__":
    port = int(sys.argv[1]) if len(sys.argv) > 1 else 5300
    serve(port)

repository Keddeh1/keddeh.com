#!/usr/bin/env python3
"""Runtime manager for KEDDEH.COM local runtime environment.

Uses only Python standard library and local custom runtime modules.
No GitHub package dependencies are required.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional

ROOT = Path(__file__).resolve().parent.parent


class RuntimeManager:
    def __init__(self, root: Path):
        self.root = root
        self.pid_file = root / ".runtime_pids"
        self.logs_dir = root / "logs"
        self.logs_dir.mkdir(exist_ok=True)

    def up(self) -> Dict[str, object]:
        http_cmd = [sys.executable, str(self.root / "apps" / "www" / "serve.py"), "8080"]
        dns_cmd = [sys.executable, str(self.root / "apps" / "dns" / "server.py"), "5300"]

        http = subprocess.Popen(http_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        dns = subprocess.Popen(dns_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        with open(self.pid_file, "w", encoding="utf-8") as handle:
            handle.write(f"{http.pid} {dns.pid}\n")

        return {
            "http_pid": http.pid,
            "dns_pid": dns.pid,
            "http_url": "http://127.0.0.1:8080",
            "dns_url": "udp://127.0.0.1:5300",
            "custom_runtime": True,
            "github_dependencies": False,
        }

    def down(self) -> Dict[str, object]:
        if not self.pid_file.exists():
            return {"status": "stopped", "message": "No runtime pids found"}

        pids: List[int] = []
        for line in self.pid_file.read_text(encoding="utf-8").splitlines():
            for token in line.split():
                if token.strip():
                    try:
                        pids.append(int(token))
                    except ValueError:
                        continue

        for pid in pids:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass

        self.pid_file.unlink(missing_ok=True)
        return {"status": "stopped", "pids": pids}

    def status(self) -> Dict[str, object]:
        if not self.pid_file.exists():
            return {"status": "stopped", "custom_runtime": True}

        alive = []
        for line in self.pid_file.read_text(encoding="utf-8").splitlines():
            for token in line.split():
                try:
                    pid = int(token)
                except ValueError:
                    continue
                try:
                    os.kill(pid, 0)
                    alive.append(pid)
                except ProcessLookupError:
                    pass

        return {
            "status": "running" if alive else "stopped",
            "custom_runtime": True,
            "github_dependencies": False,
            "pids": alive,
        }


if __name__ == "__main__":
    manager = RuntimeManager(ROOT)
    if len(sys.argv) > 1 and sys.argv[1] == "down":
        print(json.dumps(manager.down(), indent=2))
    elif len(sys.argv) > 1 and sys.argv[1] == "status":
        print(json.dumps(manager.status(), indent=2))
    else:
        print(json.dumps(manager.up(), indent=2))
