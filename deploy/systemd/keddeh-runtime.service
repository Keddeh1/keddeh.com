[Unit]
Description=KEDDEH.COM Unified HTTPS/TCP/UDP Runtime Service
Documentation=https://github.com/Keddeh1/keddeh.com
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keddeh
Group=keddeh
WorkingDirectory=/opt/keddeh/keddeh.com
ExecStartPre=/bin/bash -c 'mkdir -p /opt/keddeh/keddeh.com/logs /opt/keddeh/keddeh.com/.certs'
ExecStart=/usr/bin/python3 /opt/keddeh/keddeh.com/runtime/keddeh_venv_runtime.py
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
KillSignal=SIGTERM
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=keddeh-runtime
PrivateTmp=true
NoNewPrivileges=true
Capabilities=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
